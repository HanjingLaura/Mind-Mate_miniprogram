# 智谱 GLM 配置
ZHIPU_API_KEY=your_zhipu_api_key_here
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4
ZHIPU_VISION_MODEL=glm-4.6v-flash

# 阿里云百炼（OpenAI 兼容模式）。LLM_PROVIDER=auto 时优先使用百炼。
DASHSCOPE_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=qwen-plus
BAILIAN_VISION_MODEL=qwen-vl-plus
LLM_PROVIDER=auto

# Agent 主动介入频控
AGENT_IDLE_NUDGE_MINUTES=120
AGENT_MAX_DAILY_INTERVENTIONS=3
AGENT_RUN_TIMEOUT_SECONDS=45
AGENT_RUN_LEASE_SECONDS=180
AGENT_PROVIDER_COOLDOWN_SECONDS=30
MODEL_REQUEST_TIMEOUT_SECONDS=20
CHAT_HISTORY_MESSAGES=60
CHAT_HISTORY_CHAR_BUDGET=24000
CHAT_CONTEXT_CHAR_BUDGET=12000

# 管理员内测配置
ADMIN_BYPASS_ENABLED=false
ADMIN_SECRET_KEY=replace_with_a_long_random_secret

# 云定时调度（生产推荐）
# 生产保持 false，由云定时桥接函数每 1 分钟 POST /internal/cron/supervision。
EMBEDDED_SCHEDULER_ENABLED=false
# 使用长随机值，云定时请求通过 X-Internal-Cron-Secret 请求头传入。
INTERNAL_CRON_SECRET=replace_with_at_least_32_random_characters

# 微信小程序官方配置
WECHAT_APPID=your_mini_program_appid_here
WECHAT_SECRET=your_mini_program_secret_here
WECHAT_SUBSCRIBE_TEMPLATE_ID=your_subscribe_template_id_here
# 生产/云托管必须保持 false；仅本地 wx.request 联调时可显式设为 true。
ALLOW_INSECURE_DEV_OPENID=false
# 跨端 App 会话签名密钥
APP_ENV=development
APP_SECRET=replace_with_a_long_random_secret
APP_TOKEN_TTL_SECONDS=2592000
CORS_ORIGINS=http://localhost:5173,http://localhost:5178

# 微信官方原生支付 V3 配置
WECHAT_MCHID=your_mch_id_here
WECHAT_APIV3_KEY=your_apiv3_key_here
WECHAT_CERT_SERIAL_NO=your_cert_serial_no_here
WECHAT_NOTIFY_URL=https://your-domain.com/api/pay/callback
# 本地二选一使用 PATH；云托管推荐使用 B64 环境变量，避免把私钥打进镜像。
WECHAT_PRIVATE_KEY_PATH=/app/certs/apiclient_key.pem
WECHAT_PRIVATE_KEY_B64=
# 新商户默认使用微信支付公钥模式；填公钥 ID，并提供公钥文件或 base64 内容。
WECHAT_PAY_PUBLIC_KEY_ID=PUB_KEY_ID_your_wechat_pay_public_key_id_here
WECHAT_PAY_PUBLIC_KEY_PATH=/app/certs/wechatpay_public_key.pem
WECHAT_PAY_PUBLIC_KEY_B64=
# 仅兼容历史平台证书模式；新项目优先使用上方微信支付公钥。
WECHAT_PLATFORM_CERT_PATH=/app/certs/wechatpay_cert.pem
WECHAT_PLATFORM_CERT_B64=

# 数据库（本地可用 SQLite；云托管必须手工配置持久化 MySQL/PostgreSQL URL）
DATABASE_URL=sqlite:///./mind_mate.db
