# 智谱 GLM 配置
ZHIPU_API_KEY=your_zhipu_api_key_here
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4

# 管理员内测配置
ADMIN_BYPASS_ENABLED=false
ADMIN_SECRET_KEY=replace_with_a_long_random_secret

# 微信小程序官方配置
WECHAT_APPID=your_mini_program_appid_here
WECHAT_SECRET=your_mini_program_secret_here
WECHAT_SUBSCRIBE_TEMPLATE_ID=your_subscribe_template_id_here

# 微信官方原生支付 V3 配置
WECHAT_MCHID=your_mch_id_here
WECHAT_APIV3_KEY=your_apiv3_key_here
WECHAT_CERT_SERIAL_NO=your_cert_serial_no_here
WECHAT_NOTIFY_URL=https://your-domain.com/api/pay/callback
# 本地二选一使用 PATH；云托管推荐使用 B64 环境变量，避免把私钥打进镜像。
WECHAT_PRIVATE_KEY_PATH=/app/certs/apiclient_key.pem
WECHAT_PRIVATE_KEY_B64=
# 新商户默认使用微信支付公钥模式；填公钥 ID，并提供公钥文件或 base64 内容。
WECHAT_PAY_PUBLIC_KEY_ID=PUB_KEY_ID_your_wechat_pay_public_key_id_here
WECHAT_PAY_PUBLIC_KEY_PATH=/app/certs/wechatpay_public_key.pem
WECHAT_PAY_PUBLIC_KEY_B64=
# 仅兼容历史平台证书模式；新项目优先使用上方微信支付公钥。
WECHAT_PLATFORM_CERT_PATH=/app/certs/wechatpay_cert.pem
WECHAT_PLATFORM_CERT_B64=

# 数据库（本地可用 SQLite；云托管必须手工配置持久化 MySQL/PostgreSQL URL）
DATABASE_URL=sqlite:///./mind_mate.db
