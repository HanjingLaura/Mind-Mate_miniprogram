/** 全局样式 — 仿微信简洁白色主题 */

page {
  background-color: #ededed;
  color: #333;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

.container {
  padding: 0 32rpx;
}

/* 通用按钮 */
.btn-primary {
  background: #07c160;
  color: #fff;
  border: none;
  border-radius: 8rpx;
  font-size: 30rpx;
  font-weight: 500;
  padding: 24rpx 48rpx;
  text-align: center;
}

.btn-primary::after {
  border: none;
}

.btn-ghost {
  background: transparent;
  color: #07c160;
  border: 2rpx solid #07c160;
  border-radius: 8rpx;
  font-size: 28rpx;
  padding: 20rpx 40rpx;
  text-align: center;
}

.btn-ghost::after {
  border: none;
}

/* 分割线 */
.divider {
  height: 1rpx;
  background: rgba(0, 0, 0, 0.06);
  margin: 24rpx 0;
}

/* 标签 */
.tag {
  display: inline-block;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 6rpx;
  background: rgba(7, 193, 96, 0.1);
  color: #07c160;
}

.tag-vip {
  background: rgba(250, 180, 0, 0.12);
  color: #d4a000;
}
