/* 任务看板样式 */
.task-board {
  background: rgba(255, 255, 255, 0.04);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.board-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.board-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
}

.board-stats {
  display: flex;
  align-items: baseline;
}

.stat-done {
  font-size: 36rpx;
  font-weight: 800;
  color: #ff6b35;
}

.stat-sep {
  margin: 0 4rpx;
  color: #666;
}

.stat-total {
  font-size: 28rpx;
  color: #999;
}

.task-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.task-item {
  display: flex;
  align-items: flex-start;
  padding: 16rpx;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 10rpx;
  transition: all 0.2s;
}

.task-item.completed {
  opacity: 0.5;
}

.task-check {
  margin-right: 16rpx;
  padding-top: 4rpx;
}

.check-box {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid #555;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #0a0a0a;
  transition: all 0.2s;
}

.check-box.checked {
  background: #ff6b35;
  border-color: #ff6b35;
}

.task-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.task-text {
  font-size: 28rpx;
  color: #e0e0e0;
  line-height: 1.5;
}

.completed .task-text {
  text-decoration: line-through;
  color: #666;
}

.task-goal {
  font-size: 22rpx;
  color: #666;
  margin-top: 4rpx;
}

.empty-tasks {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
}

.empty-icon {
  font-size: 48rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 24rpx;
  color: #666;
}
