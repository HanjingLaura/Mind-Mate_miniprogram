/* 任务看板样式 — 始终可见的任务卡片 */
.task-card {
  background: #fff;
  border-radius: 12rpx;
  margin: 0 24rpx 16rpx;
  overflow: hidden;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.06);
}

.card-summary {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
}

.summary-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.summary-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
}

.summary-count {
  font-size: 24rpx;
  color: #07c160;
  font-weight: 600;
}

.summary-count.empty {
  color: #999;
}

.expand-icon {
  font-size: 24rpx;
  color: #999;
}

/* 进度条 */
.progress-bar {
  height: 6rpx;
  background: #f0f0f0;
  margin: 0 24rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #07c160, #06ad56);
  border-radius: 3rpx;
  transition: width 0.3s ease;
}

.task-list {
  border-top: 1rpx solid #f0f0f0;
  padding: 8rpx 24rpx 16rpx;
}

.task-item {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.task-item:last-child {
  border-bottom: none;
}

.task-item.completed {
  opacity: 0.5;
}

.task-check {
  margin-right: 16rpx;
  padding-top: 4rpx;
}

.check-box {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid #ccc;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #fff;
  transition: all 0.2s;
}

.check-box.checked {
  background: #07c160;
  border-color: #07c160;
}

.task-content {
  flex: 1;
}

.task-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
}

.completed .task-text {
  text-decoration: line-through;
  color: #999;
}

/* 任务变更高亮动画 */
.highlight-add {
  animation: slideInUp 0.4s ease-out;
  background: rgba(7, 193, 96, 0.08);
}

.highlight-done {
  animation: pulseGreen 0.6s ease-out;
  background: rgba(7, 193, 96, 0.12);
}

.highlight-edit {
  animation: pulseBlue 0.6s ease-out;
  background: rgba(10, 89, 247, 0.08);
}

.highlight-delete {
  animation: fadeOut 0.5s ease-out forwards;
  background: rgba(255, 77, 79, 0.12);
}

@keyframes slideInUp {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes pulseGreen {
  0% {
    background: rgba(7, 193, 96, 0.3);
  }
  100% {
    background: rgba(7, 193, 96, 0);
  }
}

@keyframes pulseBlue {
  0% {
    background: rgba(10, 89, 247, 0.3);
  }
  100% {
    background: rgba(10, 89, 247, 0);
  }
}

@keyframes fadeOut {
  0% {
    opacity: 1;
    background: rgba(255, 77, 79, 0.3);
  }
  100% {
    opacity: 0;
    background: rgba(255, 77, 79, 0);
  }
}

/* 删除按钮 */
.task-delete {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 8rpx;
  opacity: 0;
  transition: opacity 0.2s;
}

.task-item:active .task-delete,
.task-item:hover .task-delete {
  opacity: 1;
}

.delete-icon {
  font-size: 32rpx;
  color: #ccc;
  font-weight: 300;
}

/* 无任务状态 */
.task-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.empty-hint {
  font-size: 24rpx;
  color: #bbb;
  margin-top: 8rpx;
}

/* 添加任务行 */
.add-task-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
  margin-top: 8rpx;
}

.add-input {
  flex: 1;
  height: 64rpx;
  padding: 0 20rpx;
  background: #f5f5f5;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #333;
}

.add-placeholder {
  color: #bbb;
}

.add-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.2s;
}

.add-btn.active {
  background: #07c160;
}

.add-btn-text {
  font-size: 36rpx;
  color: #999;
  font-weight: 300;
  line-height: 1;
}

.add-btn.active .add-btn-text {
  color: #fff;
}
