/* 任务看板样式 — 始终可见的任务卡片 */
.task-card {
  background: #fcfdfc;
  border: 1rpx solid #e4ece6;
  border-radius: 24rpx;
  margin: 0 24rpx 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 28rpx rgba(25, 76, 49, 0.06);
}

.card-summary {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 24rpx 18rpx;
}

.summary-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.summary-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #27352d;
}

.summary-count {
  font-size: 24rpx;
  color: #07c160;
  font-weight: 600;
}

.summary-count.empty {
  color: #999;
}

.expand-icon {
  font-size: 24rpx;
  color: #999;
}

/* 进度条 */
.progress-bar {
  height: 8rpx;
  background: #eaf1ec;
  margin: 0 24rpx;
  border-radius: 999rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: #07c160;
  border-radius: 999rpx;
  transition: width 0.3s ease;
}

.task-list {
  padding: 12rpx 24rpx 18rpx;
}

/* 执行记忆：强调事实复盘，避免做成排行榜式压力组件 */
.memory-panel {
  margin: 12rpx 0 8rpx;
  padding: 18rpx 20rpx;
  border-radius: 12rpx;
  background: #f7faf8;
  border: 1rpx solid #e2f2e8;
}

.memory-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.memory-summary-main {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  min-width: 0;
}

.memory-title {
  color: #2f3d35;
  font-size: 24rpx;
  font-weight: 600;
}

.memory-score {
  color: #07a653;
  font-size: 24rpx;
  font-weight: 700;
}

.memory-rate,
.memory-streak {
  color: #6d7c73;
  font-size: 21rpx;
}

.memory-streak {
  padding: 3rpx 10rpx;
  color: #9a6400;
  background: #fff4d6;
  border-radius: 12rpx;
}

.memory-expand {
  flex-shrink: 0;
  color: #7d8a82;
  font-size: 21rpx;
}

.memory-detail {
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #e3ece6;
}

.memory-group + .memory-group {
  margin-top: 14rpx;
}

.memory-group-label {
  display: block;
  margin-bottom: 8rpx;
  color: #66736b;
  font-size: 21rpx;
  font-weight: 600;
}

.memory-task {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin: 6rpx 0;
}

.memory-task-dot {
  width: 24rpx;
  flex-shrink: 0;
  font-size: 22rpx;
  line-height: 1.5;
  text-align: center;
}

.completed-dot {
  color: #07a653;
}

.pending-dot {
  color: #d48806;
}

.memory-task-text,
.memory-empty-text,
.memory-no-yesterday {
  color: #4e5b53;
  font-size: 23rpx;
  line-height: 1.5;
}

.memory-empty-text,
.memory-no-yesterday {
  color: #929b95;
}

.memory-footnote {
  margin-top: 14rpx;
  color: #98a19b;
  font-size: 20rpx;
}

.task-item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #edf1ee;
}

.task-item:last-child {
  border-bottom: none;
}

.task-item.completed {
  opacity: 0.68;
}

.task-check {
  margin-right: 16rpx;
  padding-top: 4rpx;
}

.check-box {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #c8d4cc;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #fff;
  transition: all 0.2s;
}

.check-box.checked {
  background: #07c160;
  border-color: #07c160;
}

.task-check:active .check-box {
  transform: scale(0.9);
}

.task-content {
  flex: 1;
  min-height: 44rpx;
}

.task-text {
  font-size: 28rpx;
  color: #2f3a33;
  line-height: 1.55;
}

.completed .task-text {
  text-decoration: line-through;
  color: #999;
}

/* 任务变更高亮动画 */
.highlight-add {
  animation: slideInUp 0.4s ease-out;
  background: rgba(7, 193, 96, 0.08);
}

.highlight-done {
  animation: pulseGreen 0.6s ease-out;
  background: rgba(7, 193, 96, 0.12);
}

.highlight-edit {
  animation: pulseBlue 0.6s ease-out;
  background: rgba(10, 89, 247, 0.08);
}

.highlight-delete {
  animation: fadeOut 0.5s ease-out forwards;
  background: rgba(255, 77, 79, 0.12);
}

@keyframes slideInUp {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes pulseGreen {
  0% {
    background: rgba(7, 193, 96, 0.3);
  }
  100% {
    background: rgba(7, 193, 96, 0);
  }
}

@keyframes pulseBlue {
  0% {
    background: rgba(10, 89, 247, 0.3);
  }
  100% {
    background: rgba(10, 89, 247, 0);
  }
}

@keyframes fadeOut {
  0% {
    opacity: 1;
    background: rgba(255, 77, 79, 0.3);
  }
  100% {
    opacity: 0;
    background: rgba(255, 77, 79, 0);
  }
}

/* 删除按钮 */
.task-delete {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 8rpx;
  opacity: 0;
  transition: opacity 0.2s;
}

.task-item:active .task-delete,
.task-item:hover .task-delete {
  opacity: 1;
}

.delete-icon {
  font-size: 32rpx;
  color: #ccc;
  font-weight: 300;
}

/* 无任务状态 */
.task-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.empty-hint {
  font-size: 24rpx;
  color: #bbb;
  margin-top: 8rpx;
}

/* 添加任务行 */
.add-task-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #edf1ee;
  margin-top: 10rpx;
}

.add-input {
  flex: 1;
  height: 64rpx;
  padding: 0 20rpx;
  background: #f7faf8;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #333;
}

.add-placeholder {
  color: #bbb;
}

.add-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #f7faf8;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.2s;
}

.add-btn.active {
  background: #07c160;
}

.add-btn-text {
  font-size: 36rpx;
  color: #999;
  font-weight: 300;
  line-height: 1;
}

.add-btn.active .add-btn-text {
  color: #fff;
}

.task-edit-overlay {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  background: rgba(31, 47, 38, 0.32);
}

.task-edit-sheet {
  width: 100%;
  box-sizing: border-box;
  padding: 36rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  background: #fcfdfc;
  border-radius: 28rpx 28rpx 0 0;
}

.task-edit-title {
  display: block;
  margin-bottom: 20rpx;
  color: #25332b;
  font-size: 32rpx;
  font-weight: 600;
}

.task-edit-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 132rpx;
  padding: 20rpx;
  color: #2f3a33;
  font-size: 28rpx;
  line-height: 1.55;
  background: #f1f6f2;
  border: 1rpx solid #dfe8e2;
  border-radius: 16rpx;
}

.task-edit-actions {
  display: flex;
  gap: 16rpx;
  justify-content: flex-end;
  margin-top: 24rpx;
}

.task-edit-button {
  min-width: 128rpx;
  padding: 18rpx 24rpx;
  text-align: center;
  font-size: 27rpx;
  border-radius: 16rpx;
}

.task-edit-button.secondary {
  color: #607066;
  background: #eef2ef;
}

.task-edit-button.primary {
  color: #fff;
  background: #07c160;
}

.task-edit-button:active {
  transform: scale(0.97);
}
