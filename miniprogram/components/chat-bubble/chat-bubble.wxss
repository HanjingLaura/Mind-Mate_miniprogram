/* 聊天气泡样式 — 仿微信白色主题 */
.bubble {
  display: flex;
  align-items: flex-start;
  margin-bottom: 12rpx;
  padding: 0 24rpx;
}

.bubble-user {
  margin-bottom: 28rpx;
}

.bubble-user {
  flex-direction: row-reverse;
}

.avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 8rpx;
  background: #fff3e0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-emoji {
  font-size: 32rpx;
}

.bubble-content {
  max-width: 70%;
  margin: 0 16rpx;
}

.bubble-user .bubble-content {
  background: #95ec69;
  border-radius: 8rpx;
  padding: 18rpx 24rpx;
}

.bubble-ai .bubble-content {
  background: #fff;
  border-radius: 8rpx;
  padding: 18rpx 24rpx;
}

.bubble-text {
  font-size: 28rpx;
  line-height: 1.7;
  color: #333;
  word-break: break-all;
}

.bubble-user .bubble-text {
  color: #222;
}

.bubble-time {
  font-size: 20rpx;
  color: #bbb;
  margin-top: 6rpx;
}

