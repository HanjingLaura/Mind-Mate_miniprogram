/* 聊天气泡样式 — 仿微信白色主题 */
.bubble {
  display: flex;
  align-items: flex-start;
  margin-bottom: 12rpx;
  padding: 0 24rpx;
}

.bubble-user {
  margin-bottom: 28rpx;
}

.bubble-user {
  flex-direction: row-reverse;
}

.avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: #e8e8e8;
  border: 1rpx solid #dddddd;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-image {
  width: 100%;
  height: 100%;
  border-radius: 14rpx;
}

.avatar-default {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #e8e8e8;
}

.avatar-default-head {
  position: absolute;
  top: 10rpx;
  left: 19rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #b9b9b9;
}

.avatar-default-body {
  position: absolute;
  left: 8rpx;
  bottom: -6rpx;
  width: 40rpx;
  height: 30rpx;
  border-radius: 22rpx 22rpx 8rpx 8rpx;
  background: #b9b9b9;
}

.avatar:active {
  transform: scale(0.94);
}

.bubble-stack {
  max-width: 70%;
  margin: 0 16rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.bubble-user .bubble-stack {
  align-items: flex-end;
}

.bubble-content {
  max-width: 100%;
}

.bubble-user .bubble-content {
  background: #95ec69;
  border-radius: 20rpx;
  padding: 18rpx 24rpx;
}

.bubble-ai .bubble-content {
  background: #fcfdfc;
  border: 1rpx solid #e6eee8;
  border-radius: 20rpx;
  padding: 18rpx 24rpx;
}

.bubble-text {
  font-size: 28rpx;
  line-height: 1.7;
  color: #333;
  word-break: break-all;
}

.bubble-user .bubble-text {
  color: #222;
}

.bubble-time {
  font-size: 20rpx;
  color: #bbb;
  margin-top: 8rpx;
  padding: 0 4rpx;
  line-height: 1;
}
