<!-- 聊天气泡组件 -->
<view class="bubble {{role === 'user' ? 'bubble-user' : 'bubble-ai'}}">
  <view class="avatar" wx:if="{{role === 'assistant'}}">
    <text class="avatar-emoji">🔥</text>
  </view>
  <view class="bubble-content">
    <text class="bubble-text" user-select="{{true}}">{{content}}</text>
    <text class="bubble-time" wx:if="{{time && !isTyping}}">{{time}}</text>
  </view>
</view>
