/* 设置页 — 贴近微信设置列表的灰底白卡风格 */
.settings-page {
  min-height: 100vh;
  background: #ededed;
  padding: 24rpx;
  box-sizing: border-box;
}

.profile-card,
.settings-section {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

.profile-card {
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.profile-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #111;
  margin-bottom: 8rpx;
}

.profile-desc {
  display: block;
  font-size: 25rpx;
  color: #777;
  line-height: 1.5;
  max-width: 520rpx;
}

.profile-tag {
  font-size: 24rpx;
  color: #777;
  background: #f3f4f6;
  border-radius: 8rpx;
  padding: 8rpx 16rpx;
  flex-shrink: 0;
}

.profile-tag.active {
  color: #111;
  background: #f5d77c;
  font-weight: 700;
}

.settings-section {
  padding: 8rpx 0;
}

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #111;
  padding: 24rpx 32rpx 12rpx;
}

.section-title.no-margin {
  padding: 0;
}

.section-head {
  min-height: 96rpx;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-arrow {
  font-size: 26rpx;
  color: #888;
}

.benefit-row {
  min-height: 120rpx;
  display: flex;
  align-items: center;
  padding: 20rpx 32rpx;
  border-top: 1rpx solid #f2f2f2;
  gap: 20rpx;
}

.benefit-mark {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  background: #f2f3f5;
  color: #111;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.benefit-copy,
.notify-copy,
.upgrade-copy {
  flex: 1;
  min-width: 0;
}

.benefit-title,
.notify-title,
.upgrade-title {
  display: block;
  font-size: 29rpx;
  color: #222;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.benefit-desc,
.notify-desc,
.upgrade-desc {
  display: block;
  font-size: 24rpx;
  color: #888;
  line-height: 1.45;
}

.benefit-status {
  color: #07c160;
  font-size: 24rpx;
  flex-shrink: 0;
}

.benefit-status.vip {
  color: #111;
  background: #f5d77c;
  border-radius: 8rpx;
  padding: 6rpx 12rpx;
  font-weight: 700;
}

.notify-card,
.upgrade-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx 30rpx;
  gap: 24rpx;
}

.notify-action {
  color: #07c160;
  font-size: 28rpx;
  flex-shrink: 0;
}

.upgrade-card {
  background: #111;
  color: #fff;
  margin: 16rpx;
  border-radius: 16rpx;
}

.upgrade-title {
  color: #fff;
}

.upgrade-desc {
  color: rgba(255, 255, 255, 0.72);
}

.upgrade-price {
  color: #fff;
  font-size: 36rpx;
  font-weight: 800;
}

.time-item {
  min-height: 96rpx;
  padding: 0 32rpx;
  border-top: 1rpx solid #f2f2f2;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.label-text {
  font-size: 28rpx;
  color: #333;
}

.time-value-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.time-value {
  font-size: 28rpx;
  color: #07c160;
  font-weight: 600;
}

.mini-vip {
  font-size: 20rpx;
  color: #7a5a00;
  background: #f5d77c;
  border-radius: 6rpx;
  padding: 2rpx 8rpx;
}

.admin-entry {
  text-align: center;
  padding: 36rpx 0;
}

.admin-text {
  font-size: 22rpx;
  color: #bbb;
}

.vip-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 9999;
  display: flex;
  align-items: flex-end;
}

.vip-modal {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 20rpx 40rpx 44rpx;
  padding-bottom: calc(44rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: stretch;
}

.vip-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #dedede;
  align-self: center;
  margin-bottom: 28rpx;
}

.vip-kicker {
  font-size: 24rpx;
  color: #07c160;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.vip-title {
  font-size: 40rpx;
  line-height: 1.35;
  color: #111;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.vip-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.vip-features {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.vip-feat {
  background: #f7f7f7;
  border-radius: 12rpx;
  color: #222;
  font-size: 27rpx;
  padding: 20rpx 22rpx;
}

.vip-price {
  font-size: 38rpx;
  color: #111;
  font-weight: 800;
  margin-bottom: 20rpx;
}

.vip-skip {
  text-align: center;
  color: #999;
  font-size: 24rpx;
  padding-top: 20rpx;
}
