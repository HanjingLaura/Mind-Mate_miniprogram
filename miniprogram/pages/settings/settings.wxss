/* 设置页样式 */
.settings-page {
  min-height: 100vh;
  background: #0a0a0a;
  padding: 32rpx;
}

.settings-section {
  background: rgba(255, 255, 255, 0.04);
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
  display: block;
  margin-bottom: 8rpx;
}

.section-desc {
  font-size: 24rpx;
  color: #666;
  display: block;
  margin-bottom: 24rpx;
}

.time-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.04);
}

.time-item:last-child {
  border-bottom: none;
}

.time-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.label-icon {
  font-size: 32rpx;
}

.label-text {
  font-size: 28rpx;
  color: #e0e0e0;
}

.time-value-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.time-value {
  font-size: 30rpx;
  font-weight: 600;
  color: #ff6b35;
}

.vip-badge {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  background: rgba(255, 215, 0, 0.15);
  color: #ffd700;
}

.vip-status {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.vip-label {
  font-size: 28rpx;
  color: #e0e0e0;
}

.btn-primary {
  margin-top: 16rpx;
}

.admin-entry {
  text-align: center;
  padding: 40rpx 0;
}

.admin-text {
  font-size: 22rpx;
  color: #333;
}
