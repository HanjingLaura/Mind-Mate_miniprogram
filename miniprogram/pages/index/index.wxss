/* 聊天主页样式 — 仿微信白色主题 */
.page-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  position: relative;
  background: #ededed;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  height: 88rpx;
  background: #ededed;
  border-bottom: 1rpx solid #d9d9d9;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

.nav-actions {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
}

.nav-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.nav-icon {
  font-size: 36rpx;
  color: #666;
}

/* 聊天区域 */
.chat-area {
  flex: 1;
  overflow-y: auto;
  padding-top: 16rpx;
  padding-bottom: 16rpx;
}

.messages {
  padding-bottom: 32rpx;
}

/* 加载更多 */
.load-more {
  display: flex;
  justify-content: center;
  padding: 16rpx 0;
}

.load-more-text {
  font-size: 24rpx;
  color: #999;
}

/* 日期分隔符 */
.date-divider {
  display: flex;
  justify-content: center;
  margin: 24rpx 0 16rpx;
}

.date-text {
  font-size: 22rpx;
  color: #999;
  background: rgba(0, 0, 0, 0.04);
  padding: 4rpx 20rpx;
  border-radius: 8rpx;
}

/* 输入区域 */
.input-area {
  padding: 12rpx 24rpx;
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
  background: #f7f7f7;
  border-top: 1rpx solid #d9d9d9;
}

.input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.chat-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  background: #fff;
  border-radius: 8rpx;
  color: #333;
  font-size: 28rpx;
  border: 1rpx solid #e0e0e0;
}

.input-placeholder {
  color: #bbb;
}

.send-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 8rpx;
  background: #e0e0e0;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}

.send-btn.active {
  background: #07c160;
}

.send-icon {
  font-size: 36rpx;
  color: #999;
  font-weight: 700;
}

.send-btn.active .send-icon {
  color: #fff;
}

/* VIP 弹窗 */
.vip-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
}

.vip-modal {
  width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.vip-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 16rpx;
}

.vip-desc {
  font-size: 26rpx;
  color: #888;
  text-align: center;
  margin-bottom: 32rpx;
}

.vip-features {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.vip-feat {
  font-size: 26rpx;
  color: #555;
}

.vip-price {
  font-size: 40rpx;
  font-weight: 800;
  color: #07c160;
  margin-bottom: 32rpx;
}

.vip-actions {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.vip-actions .btn-primary {
  width: 100%;
}

.vip-skip {
  font-size: 24rpx;
  color: #999;
  padding: 8rpx;
}
