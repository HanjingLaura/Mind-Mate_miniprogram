/* 聊天主页样式 — 仿微信白色主题 */
.page-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  position: relative;
  background: #ededed;
}

/* 导航栏 */
/* 聊天区域 */
.chat-area {
  flex: 1;
  overflow-y: auto;
  padding-top: 24rpx;
  padding-bottom: 16rpx;
}

.messages {
  padding-bottom: 32rpx;
}

/* 加载更多 */
.load-more {
  display: flex;
  justify-content: center;
  padding: 16rpx 0;
}

.load-more-text {
  font-size: 24rpx;
  color: #999;
}

/* 日期分隔符 */
.date-divider {
  display: flex;
  justify-content: center;
  margin: 24rpx 0 16rpx;
}

.date-text {
  font-size: 22rpx;
  color: #999;
  background: #e9efea;
  padding: 5rpx 18rpx;
  border-radius: 999rpx;
}

/* 输入区域 */
.input-area {
  padding: 12rpx 24rpx;
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
  background: #f7f7f7;
  border-top: 1rpx solid #d9d9d9;
}

.input-row {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
}

.chat-input-shell {
  flex: 1;
  min-height: 80rpx;
  max-height: 288rpx;
  padding: 15rpx 24rpx;
  background: #fff;
  border-radius: 16rpx;
  border: 1rpx solid #dfe8e2;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  position: relative;
  overflow: hidden;
}

.chat-placeholder {
  position: absolute;
  left: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  color: #bbb;
  font-size: 28rpx;
  line-height: 1;
  pointer-events: none;
  z-index: 0;
}

.chat-input {
  width: 100%;
  min-height: 48rpx;
  max-height: 256rpx;
  padding: 0;
  margin: 0;
  background: transparent;
  color: #27352d;
  font-size: 28rpx;
  line-height: 48rpx;
  box-sizing: border-box;
  overflow-y: auto;
  display: block;
  position: relative;
  z-index: 1;
}

/* iOS textarea 的光标按字体基线绘制，单行时需要轻微下移才能视觉居中。 */
.chat-input.single-line {
  transform: translateY(6rpx);
}

.settings-btn {
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
  border-radius: 16rpx;
  background: #f7f7f7;
  border: 1rpx solid #e1e7e3;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.settings-btn:active {
  background: #edf3ee;
}

.send-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  background: #f7f7f7;
  border: 1rpx solid #e1e7e3;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}

.send-btn.active {
  background: #f7f7f7;
}

.send-btn:active {
  transform: scale(0.96);
}


.send-icon {
  font-size: 36rpx;
  color: #999;
  font-weight: 700;
}

.send-btn.active .send-icon {
  color: #999;
}

/* VIP 弹窗 */
.vip-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 9999;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.vip-modal {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 20rpx 40rpx 44rpx;
  padding-bottom: calc(44rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: stretch;
}

.vip-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #dedede;
  align-self: center;
  margin-bottom: 28rpx;
}

.vip-kicker {
  font-size: 24rpx;
  color: #07c160;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.vip-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #111;
  margin-bottom: 16rpx;
  line-height: 1.35;
}

.vip-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 28rpx;
}

.vip-features {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 28rpx;
}

.vip-feat {
  background: #f7f7f7;
  border-radius: 12rpx;
  padding: 20rpx 22rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.vip-feat-title {
  font-size: 28rpx;
  color: #222;
  font-weight: 600;
}

.vip-feat-desc {
  font-size: 24rpx;
  color: #777;
  line-height: 1.45;
}

.vip-price {
  font-size: 38rpx;
  font-weight: 800;
  color: #111;
  margin-bottom: 20rpx;
}

.vip-actions {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.vip-actions .btn-primary {
  width: 100%;
}

.vip-skip {
  font-size: 24rpx;
  color: #999;
  padding: 8rpx;
}

.reason-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 10000;
  display: flex;
  align-items: flex-end;
}

.reason-sheet {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.reason-title {
  display: block;
  color: #111;
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 18rpx;
}

.reason-item {
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.reason-label {
  font-size: 30rpx;
  color: #222;
}

.reason-cancel {
  margin-top: 18rpx;
  padding: 26rpx 0;
  text-align: center;
  color: #888;
  font-size: 28rpx;
}
