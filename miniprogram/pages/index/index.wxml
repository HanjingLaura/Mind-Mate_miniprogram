<!-- 心智同行 聊天主页 -->
<view class="page-container">
  <!-- 导航栏 -->
  <view class="nav-bar">
    <view class="nav-title-wrap">
      <text class="nav-title">{{isStreaming ? '对方正在输出中...' : '心智同行'}}</text>
      <view class="nav-vip-badge" wx:if="{{isVip}}">VIP</view>
      <view class="nav-vip-btn" wx:else bindtap="showVipPrompt">升级VIP</view>
    </view>
    <view class="nav-actions">
      <view class="nav-btn" bindtap="onSettingsTap">
        <text class="nav-icon">⚙</text>
      </view>
    </view>
  </view>

  <!-- 聊天区域 -->
  <scroll-view
    class="chat-area"
    scroll-y
    scroll-into-view="{{scrollTarget}}"
    scroll-with-animation
    bindscrolltoupper="loadOlderMessages"
  >
    <view class="load-more" wx:if="{{loadingMore}}">
      <text class="load-more-text">加载中...</text>
    </view>
    <view class="messages">
      <block wx:for="{{messages}}" wx:key="id">
        <view class="date-divider" wx:if="{{item.showDateMarker}}">
          <text class="date-text">{{item.dateLabel}}</text>
        </view>
        <chat-bubble
          role="{{item.role}}"
          content="{{item.content}}"
          time="{{item.timeLabel}}"
          isTyping="{{item.isTyping}}"
        />
        <view class="feedback-row" wx:if="{{item.role == 'assistant' && !item.feedbackSubmitted}}">
          <text
            class="feedback-chip"
            bindtap="onFeedbackTap"
            data-index="{{index}}"
            data-id="{{item.id}}"
            data-rating="useful"
          >有用</text>
          <text
            class="feedback-chip"
            bindtap="onFeedbackTap"
            data-index="{{index}}"
            data-id="{{item.id}}"
            data-rating="too_soft"
          >太轻</text>
          <text
            class="feedback-chip"
            bindtap="onFeedbackTap"
            data-index="{{index}}"
            data-id="{{item.id}}"
            data-rating="too_hard"
          >太狠</text>
          <text
            class="feedback-chip"
            bindtap="onFeedbackTap"
            data-index="{{index}}"
            data-id="{{item.id}}"
            data-rating="useless"
          >没用</text>
        </view>
      </block>
    </view>
    <view id="scroll-bottom"></view>
  </scroll-view>

  <!-- 任务看板（浮动折叠） -->
  <task-board
    id="task-board"
    openid="{{openid}}"
    bind:adminTrigger="onAdminTrigger"
  />

  <!-- VIP 弹窗 -->
  <view class="vip-overlay" wx:if="{{showVipModal}}" bindtap="closeVipModal">
    <view class="vip-modal" catchtap="">
      <view class="vip-handle"></view>
      <text class="vip-kicker">Mind-Mate VIP</text>
      <text class="vip-title">你逃的时候，我会把你叫回来</text>
      <text class="vip-desc">长时间没行动、任务快拖黄、晚上还没完成时，通过微信通知敲你一下。</text>
      <view class="vip-features">
        <view class="vip-feat">
          <text class="vip-feat-title">午后随机狙击</text>
          <text class="vip-feat-desc">不是闹钟，到你最容易摸鱼的时候出现。</text>
        </view>
        <view class="vip-feat">
          <text class="vip-feat-title">长时间无进展追问</text>
          <text class="vip-feat-desc">任务放太久，我会直接问你卡在哪。</text>
        </view>
        <view class="vip-feat">
          <text class="vip-feat-title">未完成追责</text>
          <text class="vip-feat-desc">晚上没做完，第二天继续翻旧账。</text>
        </view>
      </view>
      <text class="vip-price">¥1.99 体验包</text>
      <view class="vip-actions">
        <button class="btn-primary" bindtap="onUpgradeVip">立即升级</button>
        <text class="vip-skip" bindtap="closeVipModal">下次再说</text>
      </view>
    </view>
  </view>

  <view class="reason-overlay" wx:if="{{showVipReasonModal}}" bindtap="closeVipReasonModal">
    <view class="reason-sheet" catchtap="">
      <text class="reason-title">暂不升级的原因？</text>
      <block wx:for="{{vipReasonOptions}}" wx:key="value">
        <view class="reason-item" bindtap="onVipReasonTap" data-value="{{item.value}}">
          <text class="reason-label">{{item.label}}</text>
        </view>
      </block>
      <view class="reason-cancel" bindtap="closeVipReasonModal">不填了</view>
    </view>
  </view>

  <!-- 输入区域 -->
  <view class="input-area">
    <view class="input-row">
      <input
        class="chat-input"
        placeholder="说说你的目标..."
        placeholder-class="input-placeholder"
        value="{{inputText}}"
        bindinput="onInput"
        bindconfirm="onSend"
        confirm-type="send"
        disabled="{{isStreaming}}"
      />
      <view class="send-btn {{inputText.trim() ? 'active' : ''}}" bindtap="onSend">
        <text class="send-icon">↑</text>
      </view>
    </view>
  </view>
</view>
