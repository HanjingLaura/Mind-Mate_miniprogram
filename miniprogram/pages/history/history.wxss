/* 历史记录页 */
.history-page {
  height: 100vh;
  background: #0a0a0a;
  display: flex;
  flex-direction: column;
}

.history-header {
  padding: 32rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.header-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
}

.history-list {
  flex: 1;
  padding: 16rpx 32rpx;
}

.history-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 24rpx;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 12rpx;
  margin-bottom: 12rpx;
  transition: all 0.2s;
}

.history-item.active {
  border-left: 4rpx solid #ff6b35;
  background: rgba(255, 107, 53, 0.08);
}

.item-left {
  display: flex;
  flex-direction: column;
}

.item-date {
  font-size: 28rpx;
  color: #e0e0e0;
  font-weight: 600;
}

.item-title {
  font-size: 24rpx;
  color: #666;
  margin-top: 4rpx;
}

.item-arrow {
  font-size: 36rpx;
  color: #555;
}

.empty-history {
  display: flex;
  justify-content: center;
  padding-top: 120rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #555;
}
