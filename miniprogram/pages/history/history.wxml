<!-- 历史记录抽屉页 -->
<view class="history-page">
  <view class="history-header">
    <text class="header-title">历史对话</text>
  </view>

  <scroll-view class="history-list" scroll-y>
    <view
      class="history-item {{item.date === currentDate ? 'active' : ''}}"
      wx:for="{{conversations}}"
      wx:key="id"
      bindtap="onSelectConversation"
      data-id="{{item.id}}"
      data-date="{{item.date}}"
    >
      <view class="item-left">
        <text class="item-date">{{item.date}}</text>
        <text class="item-title">{{item.title || '日常对话'}}</text>
      </view>
      <text class="item-arrow">›</text>
    </view>

    <view class="empty-history" wx:if="{{conversations.length === 0}}">
      <text class="empty-text">还没有历史对话</text>
    </view>
  </scroll-view>
</view>
