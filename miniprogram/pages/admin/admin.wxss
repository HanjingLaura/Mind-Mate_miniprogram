/* 管理员页面 — 白色主题 */
.admin-page {
  min-height: 100vh;
  background: #ededed;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
}

.admin-card {
  width: 100%;
  max-width: 600rpx;
  background: #fff;
  border-radius: 12rpx;
  padding: 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.card-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.card-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 12rpx;
}

.card-desc {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  margin-bottom: 40rpx;
}

.input-group {
  width: 100%;
  margin-bottom: 32rpx;
}

.secret-input {
  width: 100%;
  height: 88rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  padding: 0 24rpx;
  color: #333;
  font-size: 28rpx;
  box-sizing: border-box;
  border: 1rpx solid #e0e0e0;
}

.btn-primary {
  width: 100%;
  margin-bottom: 24rpx;
}

.btn-primary.disabled {
  opacity: 0.4;
}

.result-text {
  font-size: 26rpx;
  text-align: center;
}

.result-text.success {
  color: #07c160;
}

.result-text.error {
  color: #e64340;
}

.admin-footer {
  margin-top: 64rpx;
}

.footer-text {
  font-size: 22rpx;
  color: #ccc;
}
